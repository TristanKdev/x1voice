# =============================================================================
# X1 Voice SEO / AEO / GEO Audit Engine — credentials and run configuration
# Copy to `.env` and fill in. The `.env` file is git-ignored. Never commit it.
# =============================================================================

# -- Target -------------------------------------------------------------------
# The property under audit. Origin only, no trailing slash.
AUDIT_SITE_URL=https://x1voice.com

# -----------------------------------------------------------------------------
# PRONG I — Search performance (Google Analytics 4 + Google Search Console)
# -----------------------------------------------------------------------------
# Both APIs authenticate through a single Google Cloud service account.
# 1. Create a service account in Google Cloud Console.
# 2. Grant it "Viewer" on the GA4 property (Admin > Property Access Management).
# 3. Add it as a "Full" or "Restricted" user in Search Console (Settings > Users).
# 4. Download the JSON key and point GOOGLE_APPLICATION_CREDENTIALS at it.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json

# GA4 numeric property ID (Admin > Property Settings). Digits only, no "properties/".
GA4_PROPERTY_ID=000000000

# Search Console property. For a domain property use "sc-domain:x1voice.com".
# For a URL-prefix property use the exact prefix, e.g. "https://x1voice.com/".
GSC_SITE_URL=sc-domain:x1voice.com

# Reporting window, in whole days back from today.
SEARCH_WINDOW_DAYS=90

# -----------------------------------------------------------------------------
# PRONG III — Answer & generative engine analysis
# -----------------------------------------------------------------------------
# Used only for the answer-engine probe (Prong III). The crawler and the
# access/schema probes run without it.
ANTHROPIC_API_KEY=

# Model used to simulate answer-engine responses. Leave default unless directed.
AEO_MODEL=claude-opus-4-8

# -----------------------------------------------------------------------------
# Crawl controls (Prong II)
# -----------------------------------------------------------------------------
CRAWL_MAX_PAGES=500
CRAWL_CONCURRENCY=5
CRAWL_TIMEOUT_MS=20000
CRAWL_USER_AGENT=x1voice-audit/1.0 (+https://x1voice.com/audit)
